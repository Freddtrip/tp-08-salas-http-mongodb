<h2>
    <%= seccion %>
</h2>

<% if (reservas.length===0) { %>

    <p>No hay reservas cargadas.</p>

    <% } else { %>

        <ul>
            <% reservas.forEach((reserva)=> { %>

                <li>
                    <strong>
                        <%= reserva.estudiante %>
                    </strong>
                    -
                    <%= reserva.sala %>
                        -
                        <%= reserva.fecha %>
                            -
                            <%= reserva.turno %>

                                <a href="/reservas/<%= reserva.id %>">Ver detalle</a>
                </li>

                <% }); %>
        </ul>

        <% } %>